+            .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .pNext = &timeline_info,
+            .waitSemaphoreCount = wait_main ? 1U : 0U,
+            .pWaitSemaphores = wait_main ? &main_semaphore : nullptr,
