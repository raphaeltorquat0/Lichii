+            .pNext = nullptr,
+            .waitSemaphoreValueCount = wait_main ? 1U : 0U,
+            .pWaitSemaphoreValues = wait_main ? &wait_main_tick : nullptr,
+            .signalSemaphoreValueCount = 1,
+            .pSignalSemaphoreValues = &signal_value,
+        };
