+// EDEN_NX2_ASYNC_DEP_QUEUE=1: "dependency producers" are the compute dispatches and DMA copies
+// whose output the CPU reads (GetFlushArea marks those pages like command list pages) or that
+// write GPU-written command list pages: a guest thread or the split's front waits for the host
+// GPU to finish them. Off: nothing changes. On, stage by stage: they are counted here per frame
+// (RasterizerVulkan::TickFrame logs them every 600 frames); the device opens a second queue and
+// the scheduler a second command stream for them (vulkan_device.h HasDependencyQueue,
+// vk_scheduler.h DependencyLane); they are routed there and the waits follow them.
+inline bool Nx2DepQueueEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_ASYNC_DEP_QUEUE");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+/// Counted while EDEN_NX2_ASYNC_DEP_QUEUE is on; TickFrame logs and resets them.
+inline std::atomic<u64> g_nx2_dep_producer_dispatches{};
+inline std::atomic<u64> g_nx2_dep_producer_copies{};
+inline std::atomic<u64> g_nx2_dep_routed_dispatches{}; ///< Recorded on the dependency lane
+
