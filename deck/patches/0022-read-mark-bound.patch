+                if (!reused) {
+                    // No new staging for a CPU-read page the CPU stopped reading, nor past the
+                    // live copy cap: its next read takes the generic path (FinishForHostRead).
+                    const bool stale_reader =
+                        it != nx2_list_pages.end() && it->second.cpu_read &&
+                        frame_tick - it->second.last_read_frame > Nx2CpuReadWindow;
+                    if (stale_reader || nx2_live_copies >= Nx2MaxLiveCopies) {
+                        continue;
+                    }
+                    ++nx2_live_copies;
+                }
             }
             const Nx2Staging staging =
                 reused ? *reused : runtime.DownloadStagingBuffer(page_size, true);
@@ -2263,6 +2289,7 @@ bool BufferCache<P>::Nx2CopyListPagesImpl(u64 tick, Record&& record) {
                 return false;
             }
             runtime.FreeDeferredStagingBuffer(retired.second);
+            --nx2_live_copies;
             return true;
         });
         return recorded;
