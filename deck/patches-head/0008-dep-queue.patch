+vk::CommandBuffer Scheduler::BeginDependencyCommands() {
+    DependencyLane& lane = *dependency_lane;
+    ASSERT_MSG(!lane.recording, "Dependency command buffer already open");
+    const size_t index = lane.next_buffer;
+    lane.next_buffer = (index + 1) % DependencyLane::NumBuffers;
+    // vkBeginCommandBuffer resets the buffer (RESET_COMMAND_BUFFER_BIT pool): its previous
+    // submission must be complete.
+    if (lane.ticks[index] != 0) {
+        WaitDependency(lane.ticks[index]);
+    }
+    lane.current = vk::CommandBuffer(lane.cmdbufs[index], device.GetDispatchLoader());
+    lane.current.Begin({
+        .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+        .pNext = nullptr,
+        .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+        .pInheritanceInfo = nullptr,
+    });
+    lane.ticks[index] = lane.tick + 1; // what SubmitDependencyCommands signals for it
+    lane.recording = true;
+    return lane.current;
