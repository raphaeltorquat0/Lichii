+bool SyncpointManager::UsesGuestValues() {
+    static const bool guest = [] {
+        const char* value = std::getenv("EDEN_NX2_EVENT_GUEST");
+        return value != nullptr && value[0] != '0';
+    }();
+    return guest;
+}
