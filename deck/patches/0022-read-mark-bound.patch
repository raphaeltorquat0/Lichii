+                    const bool repeated =
+                        !inserted && frame_tick - seen->second <= Nx2CpuReadWindow;
+                    seen->second = frame_tick;
+                    std::scoped_lock list_lock{nx2_list_mutex};
+                    if (const auto it = nx2_list_pages.find(page); it != nx2_list_pages.end()) {
+                        it->second.last_read_frame = frame_tick;
+                    } else if (repeated && nx2_cpu_read_marked < Nx2MaxCpuReadPages) {
+                        Nx2ListPage& entry = nx2_list_pages[page];
+                        entry.cpu_read = true;
+                        entry.last_read_frame = frame_tick;
+                        ++nx2_cpu_read_marked;
                         Tegra::Nx2MarkCommandListPage(page);
                     }
                 }
@@ -2230,6 +2245,17 @@ bool BufferCache<P>::Nx2CopyListPagesImpl(u64 tick, Record&& record) {
