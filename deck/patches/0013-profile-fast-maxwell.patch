+// EDEN_NX2_GPU_PROFILE_FAST=1: profile with Maxwell3D's fast method path kept (fast_maxwell3d),
+// the one a run without the profile takes. The back's "method" zone then times that path per
+// ring entry; the per-register counters ("3D register writes", "methods per second") only exist
+// on the slow path and read 0 for the back.
+inline const bool g_keep_fast_path = std::getenv("EDEN_NX2_GPU_PROFILE_FAST") != nullptr;
+
+inline bool KeepFastPath() {
+    return g_keep_fast_path;
+}
