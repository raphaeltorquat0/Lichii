+++ b/dist/nx2_switches.txt
@@ -40,6 +40,12 @@ EDEN_NX2_FENCE_BATCH=1
 # behaviour for Switch 1 titles): only the first read of a GPU-written page waits for the GPU.
 #EDEN_NX2_PREFLUSH=1
 
+# Pages the CPU reads after the GPU wrote them are copied to host memory right after the dispatch
+# or DMA copy that writes them (as GPU-written command list pages are); a CPU read then waits
+# only for that work's GPU tick, not for everything recorded since (Scheduler::Finish). Exact
+# data; the first read of each page still takes the generic path.
+#EDEN_NX2_READ_COPY=1
+
 # Semaphore acquires read the word without draining the split's back first (the back's own
 # releases still latch the waiter). Lets the front run ahead of the back while a channel waits
 # on a CPU-released semaphore (Ocarina of Time, most of every frame).
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
