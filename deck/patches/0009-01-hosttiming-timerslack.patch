@@ -73,6 +76,12 @@ void CoreTiming::Initialize(std::function<void()>&& on_thread_init_) {
     if (is_multicore) {
         timer_thread = std::jthread([this](std::stop_token stop_token) {
             Common::SetCurrentThreadName("HostTiming");
+#ifdef __linux__
+            // Every guest timed wait (svcSleepThread, WaitSynchronization with a timeout, the
