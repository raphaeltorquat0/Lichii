+std::optional<std::string> MacReplacementMsl(const Device& device, std::span<const u32> code,
+                                             u64 shader_hash, bool uses_tensor) {
+#ifdef __APPLE__
+    static const char* const directory = std::getenv("EDEN_MAC_NATIVE_NET");
+    if (!directory || !device.IsMoltenVK()) {
+        return std::nullopt;
+    }
+    u64 fnv = 0xcbf29ce484222325ULL;
+    for (const std::byte byte : std::as_bytes(code)) {
+        fnv = (fnv ^ static_cast<u8>(byte)) * 0x100000001b3ULL;
+    }
+    const auto path = std::filesystem::path{directory} / fmt::format("{:016x}.metal", fnv);
+    std::ifstream file{path};
+    if (!file) {
+        if (uses_tensor) {
+            LOG_INFO(Render_Vulkan, "EDEN_MAC_NATIVE_NET: tensor shader {:016x} spirv {:016x} has no {}",
+                     shader_hash, fnv, path.string());
+        }
+        return std::nullopt;
+    }
+    std::stringstream text;
+    text << file.rdbuf();
+    LOG_INFO(Render_Vulkan, "EDEN_MAC_NATIVE_NET: shader {:016x} runs {}", shader_hash,
+             path.string());
+    return text.str();
+#else
+    return std::nullopt;
+#endif
+}
+
+vk::ShaderModule BuildMslShader(const Device& device, const std::string& msl,
+                                const std::array<u32, 3>& workgroup_size) {
+    // MoltenVK's MVKMSLSPIRVHeader: the MSL source magic number, then null-terminated source.
+    constexpr u32 MslSourceMagic = 0x19960412;
+    std::vector<u32> words(1 + (msl.size() + 1 + 3) / 4, 0);
+    words[0] = MslSourceMagic;
+    std::memcpy(words.data() + 1, msl.c_str(), msl.size() + 1);
+    vk::ShaderModule module = device.GetLogical().CreateShaderModule({
+        .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .codeSize = sizeof(u32) + msl.size() + 1,
+        .pCode = words.data(),
+    });
+#ifdef __APPLE__
+    // Direct MSL carries no workgroup size; MoltenVK takes it from its private API.
+    using SetWorkgroupSize = void (*)(VkShaderModule, u32, u32, u32);
+    static const auto set_workgroup_size =
+        reinterpret_cast<SetWorkgroupSize>(dlsym(RTLD_DEFAULT, "vkSetWorkgroupSizeMVK"));
+    if (!set_workgroup_size) {
+        LOG_ERROR(Render_Vulkan, "EDEN_MAC_NATIVE_NET: vkSetWorkgroupSizeMVK not found");
+        return vk::ShaderModule{};
+    }
+    set_workgroup_size(*module, workgroup_size[0], workgroup_size[1], workgroup_size[2]);
+#endif
+    return module;
+}
+
 } // namespace Vulkan
