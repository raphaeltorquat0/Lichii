+// EDEN_NX2_READ_COPY=1 (Switch 2 titles): a page the guest CPU reads after the GPU wrote it is
+// marked like a GPU-written command list page (nx2.h). From then on the compute dispatch or DMA
+// copy that writes it also copies it to host memory right after (Nx2CopyListPages), and the next
+// CPU read is served from that copy once the GPU is past the writer's tick, instead of
+// FinishForHostRead (submit everything recorded so far and wait for all of it).
+inline bool Nx2ReadCopyEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_READ_COPY");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
