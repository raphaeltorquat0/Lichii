+template <class P>
+bool BufferCache<P>::Nx2DownloadFromListCopies(DAddr device_addr, u64 size) {
+    if constexpr (IS_OPENGL) {
+        return false;
+    } else {
+        if (size == 0 || !Tegra::g_nx2_has_command_list_pages.load(std::memory_order_relaxed)) {
+            return false;
+        }
+        constexpr DAddr page_size = DAddr{1} << Tegra::Nx2WrittenPageBits;
+        struct Part {
+            DAddr page;
+            u64 tick;
+            u32 begin;
+            u32 end;
+            const u8* data;
+        };
+        boost::container::small_vector<Part, 4> parts;
+        {
+            // Back thread: Nx2CopyListPages (the only writer of these entries) runs on it too, so
+            // the copies found here stay until this returns.
+            std::scoped_lock lock{nx2_list_mutex};
+            for (DAddr page = device_addr & ~(page_size - 1); page < device_addr + size;
+                 page += page_size) {
+                const auto it = nx2_list_pages.find(page);
+                if (it == nx2_list_pages.end()) {
+                    return false;
+                }
+                const Nx2ListPage& entry = it->second;
+                // No copy, a write outside a dispatch or DMA copy, or a write since the copy:
+                // the generic download (FinishForHostRead) stays right.
+                if (!entry.copy || entry.draw_written || entry.copy_writes != entry.writes) {
+                    return false;
+                }
+                parts.push_back({page, entry.copy_tick, entry.copy_begin, entry.copy_end,
+                                 entry.copy->mapped_span.data()});
+            }
+        }
+        // Every GPU-written byte of the pages must be within what their copies hold.
+        bool covered = true;
+        for (const Part& part : parts) {
+            gpu_modified_ranges.ForEachInRange(part.page, page_size, [&](DAddr start, DAddr end) {
+                covered &= start >= part.page + part.begin && end <= part.page + part.end;
+            });
+        }
+        if (!covered) {
+            return false;
+        }
+        // The copy went out with the work that wrote the page (SubmitNx2ListCopies): wait for
+        // that tick only, not for everything recorded since. Scheduler::Wait submits the tick
+        // itself if it is still open (this is the back thread: nobody else would).
+        for (const Part& part : parts) {
+            if (!runtime.IsFree(part.tick)) {
+                runtime.Wait(part.tick);
+            }
+        }
+        const Common::RangeSet<DAddr> cpu_written = PendingCpuWriteRanges();
+        for (const Part& part : parts) {
+            gpu_modified_ranges.ForEachInRange(part.page, page_size, [&](DAddr start, DAddr end) {
+                WriteDownloadedMemory(cpu_written, start, part.data + (start - part.page),
+                                      end - start);
+            });
+            memory_tracker.ForEachDownloadRangeAndClear(
+                part.page, page_size, [&](u64 range_addr, u64 range_size) {
+                    ClearDownload(range_addr, range_size);
+                    gpu_modified_ranges.Subtract(range_addr, range_size);
+                });
+        }
+        return true;
+    }
+}
