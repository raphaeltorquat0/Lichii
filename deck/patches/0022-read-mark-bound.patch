                 Tegra::g_nx2_ampere.load(std::memory_order_relaxed)) {
                 for (DAddr page = device_addr_start_aligned; page < device_addr_end_aligned;
                      page += DAddr{1} << Tegra::Nx2WrittenPageBits) {
