+void Scheduler::MainWaitsForDependency(u64 lane_tick) {
+    DependencyLane& lane = *dependency_lane;
+    lane.pending_main_wait = (std::max)(lane.pending_main_wait, lane_tick);
+}
+
+bool Scheduler::IsDependencyFree(u64 lane_tick) {
+    DependencyLane& lane = *dependency_lane;
+    if (lane.known_gpu_tick.load(std::memory_order_acquire) >= lane_tick) {
+        return true;
+    }
+    const u64 value = lane.semaphore.GetCounter();
+    lane.known_gpu_tick.store(value, std::memory_order_release);
+    return value >= lane_tick;
+}
+
+void Scheduler::WaitDependency(u64 lane_tick) {
+    if (IsDependencyFree(lane_tick)) {
+        return;
+    }
+    DependencyLane& lane = *dependency_lane;
+    lane.semaphore.Wait(lane_tick);
+    lane.known_gpu_tick.store(
+        (std::max)(lane.known_gpu_tick.load(std::memory_order_relaxed), lane_tick),
+        std::memory_order_release);
 }
 
